{
  "name": "private-gallery-backend",
  "version": "1.0.0",
  "description": "Private Gallery Backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npm run copy-files",
    "copy-files": "copyfiles -u 0 \"videos/**/*\" \"pictures/**/*\" \"*.json\" dist/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
